rules_version = '2';

// Files live under their owner's uid. Only the owner can read or write, images only.
// (Friends and workspace members see pictures through the download links stored in documents;
// every shared or collaborative picture is a copy in its sender's own folder.)
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    // The saved sticker is WebP (≤ 2 MB, the compression policy); PNGs (the edge-less source,
    // thumbnails and the PNG fallback) may be up to 10 MB.
    function validPicture() {
      return (request.resource.contentType == 'image/png' && request.resource.size <= 10 * 1024 * 1024)
        || (request.resource.contentType == 'image/webp' && request.resource.size < 2 * 1024 * 1024);
    }

    match /{uid}/profile/profile_pic/{file=**} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        // a photo, not any image: SVG and HTML can carry script and are served from this origin
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp']
        && request.resource.size < 2 * 1024 * 1024;
      allow delete: if isOwner(uid);
    }

    // stickers, journal thumbnails and pictures, copies made for sharing, copies made for working together
    // A sticker's small picture (`<id>_t.webp`, 320 px, about 10 kB) is held to 100 kB, so a tile can
    // never be made to download something big.
    match /{uid}/stickers/{file=**} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validPicture()
        && (!request.resource.name.matches('.*_t[.]webp') || (request.resource.contentType == 'image/webp' && request.resource.size <= 100 * 1024));
      allow delete: if isOwner(uid);
    }
    match /{uid}/journals/{file=**} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validPicture();
      allow delete: if isOwner(uid);
    }
    match /{uid}/shares/{file=**} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validPicture();
      allow delete: if isOwner(uid);
    }
    match /{uid}/collab/{file=**} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validPicture();
      allow delete: if isOwner(uid);
    }
  }
}
