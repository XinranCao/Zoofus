rules_version = '2';

// Files live under their owner's uid. Only the owner can read or write, images only.
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /{uid}/profile/profile_pic/{file=**} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 2 * 1024 * 1024;
      allow delete: if isOwner(uid);
    }

    match /{uid}/stickers/{file=**} {
      allow read: if isOwner(uid);
      // The saved sticker is WebP (≤ 2 MB, the compression policy); PNGs (the edge-less source
      // and the PNG fallback) may be up to 10 MB.
      allow create, update: if isOwner(uid)
        && (
          (request.resource.contentType == 'image/png' && request.resource.size <= 10 * 1024 * 1024)
          || (request.resource.contentType == 'image/webp' && request.resource.size < 2 * 1024 * 1024)
        );
      allow delete: if isOwner(uid);
    }
  }
}
