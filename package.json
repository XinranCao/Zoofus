    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/shadows-into-light": "^5.3.0",
    "@fontsource/special-elite": "^5.3.0",
    "@fontsource/zcool-kuaile": "^5.3.0",
    "@fontsource/zcool-qingke-huangyou": "^5.3.0",
    "@fontsource/zcool-xiaowei": "^5.3.0",
    "@fontsource/zhi-mang-xing": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.3.3",
    "cn-fontsource-xiaolai-mono-sc-regular": "^1.0.3",
    "firebase": "^12.1.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "konva": "^9.3.22",
    "lxgw-wenkai-webfont": "^1.7.0",
    "polygon-clipping": "^0.15.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-i18next": "^17.0.15",
    "react-konva": "^19.3.0",
    "react-router-dom": "^7.8.1",
    "react-zoom-pan-pinch": "^4.2.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:e2e": "vite build --mode emulator --outDir dist-e2e --emptyOutDir",
    "preview:e2e": "vite preview --mode emulator --outDir dist-e2e --host 0.0.0.0 --port 4175 --strictPort",
    "predeploy": "vite build",
    "deploy": "npm run predeploy && firebase deploy",
    "test": "vitest run",
    "test:noenv": "VITE_APP_API_KEY= VITE_APP_AUTH_DOMAIN= VITE_APP_PROJECT_ID= VITE_APP_STORAGE_BUCKET= VITE_APP_MESSAGING_SENDER_ID= VITE_APP_APP_ID= VITE_APP_RECAPTCHA_SITE_KEY= VITE_USE_EMULATORS= vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "test:rules": "npx firebase-tools@14 emulators:exec --only firestore,storage --project demo-zoofus \"vitest run --config vitest.rules.config.ts\"",
    "emulators": "npx firebase-tools@14 emulators:start --only auth,firestore,storage --project demo-zoofus --import .emulator-data --export-on-exit",
    "emulators:lan": "npx firebase-tools@14 emulators:start --config firebase.lan.json --only auth,firestore,storage --project demo-zoofus --import .emulator-data --export-on-exit",
    "dev:emulated": "vite --mode emulator --host",
    "test:e2e": "npx firebase-tools@14 emulators:exec --only auth,firestore,storage --project demo-zoofus \"playwright test\""
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@napi-rs/canvas": "^1.0.10",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.9",
    "rollup": "4.59.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "rollup": "4.59.0",
    "@grpc/grpc-js": "^1.14.5"
  }
}
