rules_version = '2';

// Everything is private to its owner. Anything not matched below is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isString(value, maxLen) {
      return value is string && value.size() <= maxLen;
    }

    // users/{uid}: the owner's profile
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'nickname', 'profilePictureUrl', 'email'])
        && request.resource.data.uid == uid
        && isString(request.resource.data.nickname, 40)
        && isString(request.resource.data.profilePictureUrl, 2048)
        && isString(request.resource.data.email, 320);
      // Deleting the profile is part of deleting the account (the app removes the rest first).
      allow delete: if isOwner(uid);

      // users/{uid}/pages/{pageId}: collage / journal pages (stickers placed on a canvas).
      // Rules cannot loop over `items`, so per-item shape is validated by the client (zod);
      // here we cap the count and the scalar fields. Keep limits in sync with page.schema.ts.
      match /pages/{pageId} {
        function validPage(data) {
          return data.keys().hasOnly(['title', 'width', 'height', 'background', 'items', 'createdAt', 'updatedAt'])
            && isString(data.title, 80)
            && data.width is int && data.width >= 100 && data.width <= 4000
            && data.height is int && data.height >= 100 && data.height <= 4000
            && isString(data.background, 32)
            && data.items is list && data.items.size() <= 200
            && data.updatedAt == request.time;
        }
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && validPage(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if isOwner(uid)
          && validPage(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(uid);
      }

      // users/{uid}/stickers/{stickerId}: the owner's saved stickers
      match /stickers/{stickerId} {
        function validEdge(e) {
          return e is map
            && e.keys().hasOnly(['shape', 'scale', 'fill'])
            && e.shape in ['smooth', 'wobbly', 'torn']
            && e.scale is number && e.scale >= 0 && e.scale <= 1.6
            && e.fill is map
            && e.fill.kind in ['solid', 'stripes', 'dots', 'gingham', 'check', 'wave', 'pixels', 'doodle']
            && (!('pixels' in e.fill) || (e.fill.pixels is list && e.fill.pixels.size() == 8))
            && (!('strokes' in e.fill) || (e.fill.strokes is list && e.fill.strokes.size() <= 40));
        }
        function ownFile(path) {
          return isString(path, 512) && path.matches('^' + uid + '/stickers/.+');
        }
        // Fields shared by create and update. Older stickers have no source, edge or seed.
        function validSticker(d) {
          return d.keys().hasOnly(['name', 'storagePath', 'imageUrl', 'sourcePath', 'sourceUrl', 'edge', 'seed', 'thumbnailUrl', 'thumbnailPath', 'width', 'height', 'createdAt'])
            && isString(d.name, 60) && d.name.size() > 0
            && ownFile(d.storagePath)
            && isString(d.imageUrl, 2048)
            && (!('sourcePath' in d) || ownFile(d.sourcePath))
            && (!('sourceUrl' in d) || isString(d.sourceUrl, 2048))
            && (!('edge' in d) || validEdge(d.edge))
            && (!('seed' in d) || isString(d.seed, 64))
            && (!('thumbnailUrl' in d) || isString(d.thumbnailUrl, 2048))
            && (!('thumbnailPath' in d) || ownFile(d.thumbnailPath))
            && d.width is int && d.width > 0
            && d.height is int && d.height > 0;
        }
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && validSticker(request.resource.data)
          && request.resource.data.createdAt == request.time;
        // After creation: rename, or redo the edge (new image file, edge settings and size).
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'storagePath', 'imageUrl', 'edge', 'seed', 'width', 'height'])
          && validSticker(request.resource.data);
        allow delete: if isOwner(uid);
      }
    }
  }
}
