rules_version = '2';

// Everything is private to its owner. Anything not matched below is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isString(value, maxLen) {
      return value is string && value.size() <= maxLen;
    }
    // The 16 colours users may print with (USER_COLORS in src/paper/pattern.ts).
    function userColour(c) {
      return c in ['sheet-50', 'cream-100', 'peach-100', 'blush-100', 'pink-200', 'celery-200', 'lime-300', 'mustard-300',
                   'apricot-300', 'rose-400', 'olive-500', 'tangerine-400', 'brick-600', 'plum-900', 'moss-700', 'cocoa-800'];
    }
    function pixelRow(r) {
      return r is string && r.matches('^[01]{8}$');
    }
    // A user-designed print (tape prints and sticker-edge fills). Keep in sync with
    // src/paper/patternSchema.ts. Rules cannot loop, so the 8 pixel rows are checked one by one
    // and doodle strokes (at most 60 paths of path data) are checked for count here and for
    // content by the client; every stroke is validated again when it is drawn (isSafeStroke).
    function validPattern(p) {
      return p is map
        && p.keys().hasOnly(['kind', 'bg', 'ink', 'scale', 'angle', 'weight', 'pixels', 'strokes'])
        && p.kind in ['solid', 'stripes', 'dots', 'gingham', 'check', 'wave', 'pixels', 'doodle']
        && userColour(p.bg)
        && (!('ink' in p) || userColour(p.ink))
        && (!('scale' in p) || (p.scale is number && p.scale >= 6 && p.scale <= 28))
        && (!('angle' in p) || (p.angle is number && p.angle >= 0 && p.angle <= 180))
        && (!('weight' in p) || (p.weight is number && p.weight >= 0.1 && p.weight <= 0.9))
        && (!('pixels' in p) || (p.pixels is list && p.pixels.size() == 8
            && pixelRow(p.pixels[0]) && pixelRow(p.pixels[1]) && pixelRow(p.pixels[2]) && pixelRow(p.pixels[3])
            && pixelRow(p.pixels[4]) && pixelRow(p.pixels[5]) && pixelRow(p.pixels[6]) && pixelRow(p.pixels[7])))
        && (!('strokes' in p) || (p.strokes is list && p.strokes.size() <= 60
            && (p.strokes.size() < 1 || isPath(p.strokes[0]))));
    }
    function isPath(d) {
      return d is string && d.size() <= 2000 && d.matches('^[MLQCSTZmlqcstz0-9 .,-]+$');
    }

    // A journal's paper: its size, what it is made of, the ruling on it and its colour.
    function validPage(p) {
      return p is map
        && p.keys().hasOnly(['width', 'height', 'paper', 'pattern', 'color'])
        && p.width is int && p.width >= 300 && p.width <= 3000
        && p.height is int && p.height >= 300 && p.height <= 3000
        && p.paper in ['notebook', 'newspaper', 'magazine']
        && p.pattern in ['ruled', 'grid', 'dots', 'cross', 'blank', 'columns', 'plain', 'aged', 'gloss', 'matte']
        && userColour(p.color);
    }

    // users/{uid}: the owner's profile
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'nickname', 'profilePictureUrl', 'email', 'avatarKind', 'avatarPath'])
        && request.resource.data.uid == uid
        && isString(request.resource.data.nickname, 40) && request.resource.data.nickname.size() > 0
        && (!('avatarKind' in request.resource.data) || request.resource.data.avatarKind in ['sticker', 'photo'])
        && (!('avatarPath' in request.resource.data) || isString(request.resource.data.avatarPath, 512))
        && isString(request.resource.data.profilePictureUrl, 2048)
        && isString(request.resource.data.email, 320);
      // Deleting the profile is part of deleting the account (the app removes the rest first).
      allow delete: if isOwner(uid);

      // users/{uid}/journals/{jid}: a journal page (手账). It is a list of pointers and small
      // objects: stickers by id, tapes as their print, text, and pen strokes as compact strings.
      // Rules cannot loop over `items`, so the count and the page are bounded here and every item is
      // validated by the client (zod); the 1 MiB document limit is the final backstop.
      match /journals/{jid} {
        function validJournal(d) {
          return d.keys().hasOnly(['title', 'page', 'items', 'assets', 'thumbUrl', 'thumbPath', 'origin', 'createdAt', 'updatedAt'])
            && isString(d.title, 80) && d.title.size() > 0
            && validPage(d.page)
            && d.items is list && d.items.size() <= 400
            && (!('assets' in d) || (d.assets is map && d.assets.size() <= 80))
            && (!('thumbUrl' in d) || isString(d.thumbUrl, 2048))
            && (!('thumbPath' in d) || (isString(d.thumbPath, 512) && d.thumbPath.matches('^' + uid + '/journals/.+')))
            && (!('origin' in d) || (d.origin is map && d.origin.keys().hasOnly(['from', 'workspace'])))
            && d.updatedAt == request.time;
        }
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && validJournal(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if isOwner(uid)
          && validJournal(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(uid);
      }

      // users/{uid}/collections/{cid}: a collection the person makes up: pointers to their own
      // stickers, tapes and journals.
      match /collections/{cid} {
        function validCollection(d) {
          return d.keys().hasOnly(['name', 'items', 'createdAt', 'updatedAt'])
            && isString(d.name, 60) && d.name.size() > 0
            && d.items is list && d.items.size() <= 500
            && (d.items.size() < 1 || (d.items[0] is map && d.items[0].keys().hasOnly(['k', 'id'])
                && d.items[0].k in ['sticker', 'tape', 'journal'] && isString(d.items[0].id, 64)))
            && d.updatedAt == request.time;
        }
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && validCollection(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if isOwner(uid)
          && validCollection(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(uid);
      }

      // users/{uid}/friends/{fid}: the people I am connected to. `nickname` is MY name for them.
      // A friendship is two documents: mine, and theirs. Accepting a request writes both in one batch.
      match /friends/{fid} {
        allow read: if isOwner(uid);
        // I accept a request that fid sent me ...
        allow create: if (isOwner(uid) && uid != fid
                          && exists(/databases/$(database)/documents/users/$(uid)/requests/$(fid))
                          && validFriend(request.resource.data))
          // ... or I (fid) am completing my side of a friendship by writing the other person's document
          || (request.auth.uid == fid && uid != fid
                          && exists(/databases/$(database)/documents/users/$(fid)/requests/$(uid))
                          && validFriend(request.resource.data));
        // naming a friend
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname'])
          && validFriend(request.resource.data);
        // unfriending removes both documents: mine, or the one the other person wrote in my list
        allow delete: if isOwner(uid) || request.auth.uid == fid;
      }
      function validFriend(d) {
        return d.keys().hasOnly(['since', 'nickname'])
          && d.since is timestamp
          && (!('nickname' in d) || isString(d.nickname, 40));
      }

      // users/{uid}/requests/{from}: a friend request waiting for me, written by the sender.
      match /requests/{from} {
        allow read: if isOwner(uid) || request.auth.uid == from;
        allow create: if request.auth.uid == from && uid != from
          && !exists(/databases/$(database)/documents/users/$(uid)/friends/$(from))
          && request.resource.data.keys().hasOnly(['from', 'createdAt'])
          && request.resource.data.from == from
          && request.resource.data.createdAt == request.time;
        allow delete: if isOwner(uid) || request.auth.uid == from;
      }
      // users/{uid}/sentRequests/{to}: my own record of a request I sent (to list and cancel it).
      match /sentRequests/{to} {
        allow read: if isOwner(uid);
        // I cancel it, or the person it was sent to answers it
        allow delete: if isOwner(uid) || request.auth.uid == to;
        allow create: if isOwner(uid) && uid != to
          && request.resource.data.keys().hasOnly(['to', 'createdAt'])
          && request.resource.data.to == to
          && request.resource.data.createdAt == request.time;
      }

      // users/{uid}/inbox/{sid}: something a friend shared with me. Only a friend (someone in my
      // friend list) can put a document here. The shared files are copies in the sender's folder.
      match /inbox/{sid} {
        function validShare(d) {
          return d.keys().hasOnly(['from', 'kind', 'name', 'note', 'payload', 'files', 'seen', 'createdAt'])
            && d.from == request.auth.uid
            && d.kind in ['sticker', 'tape', 'journal']
            && isString(d.name, 80)
            && (!('note' in d) || isString(d.note, 200))
            && d.payload is map
            && d.files is list && d.files.size() <= 100
            && d.seen == false
            && d.createdAt == request.time;
        }
        allow read: if isOwner(uid);
        allow create: if signedIn() && uid != request.auth.uid
          && exists(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid))
          && validShare(request.resource.data);
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen', 'saved']);
        allow delete: if isOwner(uid) || resource.data.from == request.auth.uid;
      }
      // users/{uid}/sent/{sid}: what I shared, so I can take it back and clean up its files.
      match /sent/{sid} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['to', 'kind', 'name', 'files', 'createdAt'])
          && request.resource.data.files is list && request.resource.data.files.size() <= 100;
      }

      // users/{uid}/tapes/{tapeId}: "My tape roll" (a TapeSpec: name, print, width, see-through, ends).
      // Angle and length belong to each placement on a page, not to the saved tape.
      match /tapes/{tapeId} {
        function validTape(d) {
          return d.keys().hasOnly(['name', 'pattern', 'thickness', 'opacity', 'ends', 'createdAt'])
            && isString(d.name, 40) && d.name.size() > 0
            && validPattern(d.pattern)
            && d.thickness is number && d.thickness >= 12 && d.thickness <= 36
            && d.opacity is number && d.opacity >= 0.5 && d.opacity <= 1
            && d.ends in ['torn', 'cut', 'pinked'];
        }
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && validTape(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && validTape(request.resource.data);
        allow delete: if isOwner(uid);
      }

      // users/{uid}/stickers/{stickerId}: the owner's saved stickers
      match /stickers/{stickerId} {
        function validEdge(e) {
          return e is map
            && e.keys().hasOnly(['shape', 'scale', 'fill'])
            && e.shape in ['smooth', 'wobbly', 'torn']
            && e.scale is number && e.scale >= 0 && e.scale <= 1.6
            && validPattern(e.fill);
        }
        function ownFile(path) {
          return isString(path, 512) && path.matches('^' + uid + '/stickers/.+');
        }
        // Fields shared by create and update. Older stickers have no source, edge or seed.
        function validSticker(d) {
          return d.keys().hasOnly(['name', 'storagePath', 'imageUrl', 'sourcePath', 'sourceUrl', 'edge', 'seed', 'thumbnailUrl', 'thumbnailPath', 'width', 'height', 'createdAt'])
            && isString(d.name, 60) && d.name.size() > 0
            && ownFile(d.storagePath)
            && isString(d.imageUrl, 2048)
            && (!('sourcePath' in d) || ownFile(d.sourcePath))
            && (!('sourceUrl' in d) || isString(d.sourceUrl, 2048))
            && (!('edge' in d) || validEdge(d.edge))
            && (!('seed' in d) || isString(d.seed, 64))
            && (!('thumbnailUrl' in d) || isString(d.thumbnailUrl, 2048))
            && (!('thumbnailPath' in d) || ownFile(d.thumbnailPath))
            && d.width is int && d.width > 0
            && d.height is int && d.height > 0;
        }
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && validSticker(request.resource.data)
          && request.resource.data.createdAt == request.time;
        // After creation: rename, or redo the edge (new image file, edge settings and size). Only what
        // changes is checked: a sticker saved by an earlier version may hold older values in fields
        // that are not being touched (a long name, a different size type), and must still be editable.
        function touched(d, key) {
          return d.diff(resource.data).affectedKeys().hasAny([key]);
        }
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'storagePath', 'imageUrl', 'edge', 'seed', 'width', 'height'])
          && (!touched(request.resource.data, 'name') || (isString(request.resource.data.name, 60) && request.resource.data.name.size() > 0))
          && (!touched(request.resource.data, 'storagePath') || ownFile(request.resource.data.storagePath))
          && (!touched(request.resource.data, 'imageUrl') || isString(request.resource.data.imageUrl, 2048))
          && (!touched(request.resource.data, 'edge') || validEdge(request.resource.data.edge))
          && (!touched(request.resource.data, 'seed') || isString(request.resource.data.seed, 64))
          && (!touched(request.resource.data, 'width') || (request.resource.data.width is int && request.resource.data.width > 0))
          && (!touched(request.resource.data, 'height') || (request.resource.data.height is int && request.resource.data.height > 0));
        allow delete: if isOwner(uid);
      }
    }

    // publicProfiles/{uid}: what a friend (or someone with my friend code) may see: my nickname and
    // picture. No email, and no listing: a profile can only be read by its id.
    match /publicProfiles/{uid} {
      allow get: if signedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['nickname', 'avatarUrl', 'avatarKind', 'avatarKey', 'friendCode', 'updatedAt'])
        && isString(request.resource.data.nickname, 40) && request.resource.data.nickname.size() > 0
        && isString(request.resource.data.avatarUrl, 40000)
        && (!('avatarKey' in request.resource.data) || isString(request.resource.data.avatarKey, 16))
        && (!('avatarKind' in request.resource.data) || request.resource.data.avatarKind in ['sticker', 'photo'])
        && request.resource.data.friendCode is string
        && request.resource.data.friendCode.matches('^[A-HJ-NP-Z2-9]{8}$')
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(uid);
    }
    // friendCodes/{code} -> { uid }: how someone finds me from my code. Readable one code at a time,
    // never listed, so codes cannot be harvested.
    match /friendCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && code.matches('^[A-HJ-NP-Z2-9]{8}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // workspaces/{wid}: a journal several friends make together, live. The document holds who is in
    // and the paper; every object on the page is its own document in `items`, so two people moving
    // different things never overwrite each other.
    function isMember(wid) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(wid)).data.members;
    }
    match /workspaces/{wid} {
      function validWorkspace(d) {
        return d.keys().hasOnly(['title', 'ownerUid', 'members', 'invited', 'page', 'createdAt', 'updatedAt'])
          && isString(d.title, 80) && d.title.size() > 0
          && d.members is list && d.members.size() >= 1 && d.members.size() <= 8
          && d.invited is list && d.invited.size() <= 12
          && validPage(d.page);
      }
      allow read: if signedIn()
        && (request.auth.uid in resource.data.members || request.auth.uid in resource.data.invited);
      allow create: if signedIn()
        && validWorkspace(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn() && (
        // a member changes the title, the paper or who is invited
        (request.auth.uid in resource.data.members
          && validWorkspace(request.resource.data)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.members == resource.data.members
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time)
        // an invited friend joins: they move from `invited` to `members`, nothing else changes
        || (request.auth.uid in resource.data.invited
          && validWorkspace(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'invited', 'updatedAt'])
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.hasAll(resource.data.members)
          && request.auth.uid in request.resource.data.members
          && !(request.auth.uid in request.resource.data.invited)
          && request.resource.data.updatedAt == request.time)
        // an invited friend says no: they come off `invited`, nothing else changes
        || (request.auth.uid in resource.data.invited
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['invited', 'updatedAt'])
          && request.resource.data.invited.size() == resource.data.invited.size() - 1
          && !(request.auth.uid in request.resource.data.invited)
          && request.resource.data.updatedAt == request.time)
        // a member (not the owner) leaves
        || (request.auth.uid in resource.data.members
          && request.auth.uid != resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt'])
          && request.resource.data.members.size() == resource.data.members.size() - 1
          && !(request.auth.uid in request.resource.data.members)
          && request.resource.data.updatedAt == request.time)
      );
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // one object on the page
      match /items/{iid} {
        function validItem(d) {
          return d.keys().hasOnly(['t', 'by', 'upd', 'x', 'y', 'r', 'z', 'ref', 'sc', 'sy', 'tape', 'len', 'text', 'font', 'size', 'color', 'bold', 'w', 'tool', 'pts'])
            && d.t in ['s', 't', 'x', 'p']
            && d.by == request.auth.uid
            && d.upd == request.time
            && (!('x' in d) || (d.x is number && d.x > -20000 && d.x < 20000))
            && (!('y' in d) || (d.y is number && d.y > -20000 && d.y < 20000))
            && (!('r' in d) || (d.r is number && d.r >= -720 && d.r <= 720))
            && (!('z' in d) || d.z is int)
            && (!('ref' in d) || isString(d.ref, 70))
            && (!('sc' in d) || (d.sc is number && d.sc > 0.02 && d.sc < 40))
            && (!('sy' in d) || (d.sy is number && d.sy > 0.04 && d.sy < 21))
            && (!('tape' in d) || d.tape is map)
            && (!('len' in d) || (d.len is number && d.len >= 10 && d.len <= 3000))
            && (!('text' in d) || isString(d.text, 500))
            && (!('font' in d) || isString(d.font, 32))
            && (!('size' in d) || (d.size is number && d.size >= 4 && d.size <= 600))
            && (!('color' in d) || isString(d.color, 32))
            && (!('bold' in d) || d.bold is bool)
            && (!('w' in d) || (d.w is number && d.w > 0 && d.w <= 4000))
            && (!('tool' in d) || d.tool in ['pen', 'pencil', 'marker', 'crayon'])
            && (!('pts' in d) || isString(d.pts, 8000));
        }
        allow read: if isMember(wid);
        allow create, update: if isMember(wid) && validItem(request.resource.data);
        allow delete: if isMember(wid);
      }
      // something brought onto the shelf by one member, for everyone to use: a sticker (its picture,
      // shrunk, kept inside the entry: members cannot read each other's files) or a tape (its print)
      match /assets/{aid} {
        function ownCollabFile(path) {
          return isString(path, 512) && path.matches('^' + request.auth.uid + '/collab/.+');
        }
        allow read: if isMember(wid);
        allow create: if isMember(wid)
          && request.resource.data.keys().hasOnly(['owner', 'kind', 'url', 'path', 'w', 'h', 'name', 'tape'])
          && request.resource.data.owner == request.auth.uid
          && isString(request.resource.data.name, 80)
          && (
            (request.resource.data.kind == 'sticker'
              && isString(request.resource.data.url, 160000)
              && (!('path' in request.resource.data) || ownCollabFile(request.resource.data.path))
              && request.resource.data.w is int && request.resource.data.h is int)
            || (request.resource.data.kind == 'tape'
              && request.resource.data.tape is map
              && !('url' in request.resource.data) && !('path' in request.resource.data))
          );
        allow delete: if isMember(wid)
          && (resource.data.owner == request.auth.uid
              || get(/databases/$(database)/documents/workspaces/$(wid)).data.ownerUid == request.auth.uid);
      }
      // who is here now (a small heartbeat, one document per person)
      match /presence/{pid} {
        allow read: if isMember(wid);
        allow create, update: if isMember(wid) && pid == request.auth.uid
          && request.resource.data.keys().hasOnly(['name', 'color', 'ts'])
          && isString(request.resource.data.name, 40)
          && isString(request.resource.data.color, 32)
          && request.resource.data.ts == request.time;
        allow delete: if isMember(wid) && pid == request.auth.uid;
      }
    }
  }
}
